{
  "name": "collie",
  "version": "0.46.2",
  "private": true,
  "license": "MIT",
  "description": "Nenu — a mobile web UI to monitor and reply to your Herdr agent herd over Tailscale",
  "type": "module",
  "scripts": {
    "start": "bun run bridge/index.ts",
    "dev": "bun --watch bridge/index.ts",
    "build": "bash scripts/collie-ctl.sh build",
    "build:web": "bash scripts/collie-ctl.sh build",
    "web:dev": "cd web && bun run dev",
    "test": "bun test ./bridge ./scripts && bash scripts/collie-ctl.test.sh",
    "test:ctl": "bash scripts/collie-ctl.test.sh",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.1",
    "jsqr": "^1.4.0",
    "typescript": "^5"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "8.18.3"
  },
  "optionalDependencies": {
    "web-push": "^3.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frizynn/nenu.git"
  },
  "homepage": "https://github.com/frizynn/nenu#readme",
  "bugs": {
    "url": "https://github.com/frizynn/nenu/issues"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.0"
}
